<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Under the hardened runtime, microphone access needs this entitlement on
	     top of NSMicrophoneUsageDescription; without it the permission request
	     fails silently. Nothing else is granted: no library injection, no JIT,
	     no unsigned memory. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
